# =============================================================================
# Capital Chowdary Matrimony — Environment Variables Template
# Copy this file to `.env.local` (Next.js) or `.dev.vars` (Wrangler/Workers)
# Never commit real secrets to version control.
# =============================================================================

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Capital Chowdary Matrimony"
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000

# Administrator Authentication (Server-Only)
# Generate a strong random 32+ byte secret (e.g., `openssl rand -base64 32`)
AUTH_SESSION_SECRET=replace-with-a-minimum-32-character-random-secret
ADMIN_SESSION_COOKIE_NAME=ccm_admin_session
ADMIN_INITIAL_EMAIL=admin@capitalchowdarymatrimony.example
# Password hash generated with the project password utility (never store plain text in production)
ADMIN_INITIAL_PASSWORD_HASH=

# Cloudinary Image Management
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=capital-chowdary-matrimony

# Cloudflare D1 / Drizzle CLI (Optional for remote Drizzle Studio / CLI tooling)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

